# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# velite
.velite/

# pagefind index (built by `pnpm build:search`)
public/pagefind/

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
.spec-workflow/.cache/

# spec-workflow process artifacts: adversarial review rounds, approval
# snapshots, and per-task implementation logs. These are regenerated locally by
# the spec-workflow tooling and stay out of the repo — only the durable spec
# documentation (steering, requirements, design, tasks) is tracked.
.spec-workflow/approvals/
.spec-workflow/**/reviews/
.spec-workflow/**/Implementation Logs/
/.playwright-mcp/

# lighthouse-ci report cache (written by `pnpm exec lhci autorun`)
/.lighthouseci/

# Headless Chrome under WSL+lhci leaks user-data dirs into the cwd using a
# literal `C:\Users\...\AppData\Local\lighthouse.NNNNNN` path (the upstream
# Lighthouse default on Windows, dispatched verbatim on Linux). The CI
# config now pins --user-data-dir via chromeFlags to prevent new leaks;
# this ignore catches any that slip through if the flag is dropped.
/C:\\Users\\*

# Claude Code local config
.claude/

# CI topology runtime state (written by scripts/verify-ci-topology.mjs)
scripts/__ci-topology-state.txt
.codeindex/
.env*.local

# rtk command audit log (local-only, appended on every proxied command)
audit.log
