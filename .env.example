# Copy this file to .env.local and fill in the values.
# .env.local is gitignored — never commit real secrets.

# Resend API key. Production uses a production key; preview/dev use a
# sandbox or scoped-down key.
RESEND_API_KEY=

# Sender address. Production uses a custom-domain alias (e.g.
# hello@matthewfield.ca); preview/dev use the Resend sandbox sender.
RESEND_FROM=onboarding@resend.dev

# Recipient inbox for contact-form submissions.
RESEND_TO=

# Resend API base URL. Leave unset in production/preview — it defaults
# to https://api.resend.com. CI/dev point it at a local mock server,
# e.g. http://127.0.0.1:<port>.
RESEND_BASE_URL=

# Buttondown API key, for /api/newsletter. Required — a signup fails loudly
# without it rather than silently dropping the subscriber. Create one at
# Buttondown → Settings → API → Keys.
#
# This replaced the public embed endpoint, which needed no key: only the
# authenticated API accepts an `ip_address` field, and without forwarding the
# visitor's IP, Buttondown's firewall blocks real signups as bot traffic.
BUTTONDOWN_API_KEY=

# Buttondown API base URL. Leave unset in production/preview — it defaults to
# https://api.buttondown.com. CI/dev point it at a local mock server.
BUTTONDOWN_BASE_URL=
