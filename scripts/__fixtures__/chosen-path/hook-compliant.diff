diff --git a/velite.config.ts b/velite.config.ts
index aaaaaaa..bbbbbbb 100644
--- a/velite.config.ts
+++ b/velite.config.ts
@@ -10,6 +10,18 @@ export default defineConfig({
   collections: { posts },
+  prepare(data) {
+    const seen = new Map();
+    for (const p of data.posts) {
+      if (!p.series) continue;
+      const key = `${p.series}:${p.seriesOrder}`;
+      if (seen.has(key)) {
+        throw new Error(`series-order collision: ${key}`);
+      }
+      seen.set(key, p);
+    }
+  },
 });
