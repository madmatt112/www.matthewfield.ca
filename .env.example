# Copy this file to .env.local and fill in the values.
# .env.local is gitignored — never commit real secrets.

# Resend API key. Production uses a production key; preview/dev use a
# sandbox or scoped-down key.
RESEND_API_KEY=

# Sender address. Production uses a custom-domain alias (e.g.
# hello@matthewfield.ca); preview/dev use the Resend sandbox sender.
RESEND_FROM=onboarding@resend.dev

# Recipient inbox for contact-form submissions.
RESEND_TO=

# Resend API base URL. Leave unset in production/preview — it defaults
# to https://api.resend.com. CI/dev point it at a local mock server,
# e.g. http://127.0.0.1:<port>.
RESEND_BASE_URL=
