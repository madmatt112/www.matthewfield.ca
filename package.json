{
  "name": "matthewfield-ca",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.2",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names velite,next \"velite dev\" \"next dev --turbopack --port 3013\"",
    "build": "next build",
    "start": "next start --port 3013",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:tz": "TZ=America/Edmonton vitest run src/lib/github-activity.test.ts && TZ=Europe/Berlin vitest run src/lib/github-activity.test.ts",
    "test:e2e": "node scripts/run-e2e.mjs",
    "build:search": "node scripts/run-pagefind-crawl.mjs",
    "check:authoring-docs": "node scripts/check-authoring-docs.mjs",
    "check:playground-css": "node scripts/check-playground-css.mjs",
    "gate:github-activity": "echo '[gate] G1' && prettier --write content/github-activity.yaml && echo '[gate] G2' && velite build && echo '[gate] G3' && node scripts/check-github-activity-payload.mjs && echo '[gate] G4' && next build",
    "lhci": "node scripts/run-lhci.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "git config core.hooksPath .githooks || true",
    "postinstall": "velite build"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "feed": "4.2.2",
    "lucide-react": "^1.37.0",
    "next": "16.3.3",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-obfuscate": "^3.7.0",
    "remark-directive": "^4.0.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@pagefind/default-ui": "1.5.2",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "eslint-config-prettier": "^10.1.8",
    "fast-xml-parser": "5.11.1",
    "gray-matter": "4.0.3",
    "hast-util-to-text": "4.0.2",
    "jsdom": "^29.0.2",
    "mdast-util-to-string": "^4.0.0",
    "node-html-parser": "9.0.2",
    "pagefind": "1.5.2",
    "prettier": "^3.9.6",
    "reading-time": "^1.5.0",
    "rehype-pretty-code": "^0.14.5",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "shiki": "^4.4.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "unified": "^11.0.5",
    "unist-builder": "^4.0.0",
    "unist-util-visit": "^5.1.0",
    "velite": "0.4.0",
    "vercel": "58.5.1",
    "vitest": "^4.1.11",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": ">=24"
  },
  "pnpm": {
    "patchedDependencies": {
      "@pagefind/default-ui@1.5.2": "patches/@pagefind__default-ui@1.5.2.patch"
    },
    "overrides": {
      "tar@<7.5.19": ">=7.5.19"
    }
  }
}
